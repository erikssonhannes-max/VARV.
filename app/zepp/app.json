{
  "configVersion": "v3",
  "app": {
    "appId": 1000001,
    "appName": "VARV.",
    "appType": "app",
    "version": {
      "code": 1,
      "name": "1.0.0"
    },
    "icon": "icon.png",
    "vender": "VARV Performance",
    "description": "Kör dina pass från VARV. på klockan och spara dem i appen."
  },
  "permissions": [
    "data:os.device.info"
  ],
  "runtime": {
    "apiVersion": {
      "compatible": "3.0.0",
      "target": "3.0.0",
      "minVersion": "3.0"
    }
  },
  "targets": {
    "common": {
      "module": {
        "page": {
          "pages": ["page/index", "page/pass", "page/live"]
        },
        "app-side": {
          "path": "app-side/index"
        },
        "setting": {
          "path": "setting/index"
        }
      },
      "platforms": [
        { "st": "r" },
        { "st": "s" }
      ],
      "designWidth": 480
    }
  },
  "i18n": {
    "sv-SE": { "appName": "VARV." },
    "en-US": { "appName": "VARV." }
  },
  "defaultLanguage": "en-US"
}
